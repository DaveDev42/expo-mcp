{
  "name": "expo-mcp",
  "version": "0.3.0",
  "private": true,
  "description": "MCP server for Expo app automation with Maestro integration",
  "type": "module",
  "bin": {
    "expo-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node18 --format=esm --outfile=dist/index.js --external:@modelcontextprotocol/* --external:sharp --external:ws --external:zod",
    "dev": "esbuild src/index.ts --bundle --platform=node --target=node18 --format=esm --outfile=dist/index.js --external:@modelcontextprotocol/* --external:sharp --external:ws --external:zod --watch",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "expo",
    "react-native",
    "ios-simulator",
    "android-emulator",
    "maestro",
    "automation",
    "testing"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DaveDev42/expo-mcp.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.2",
    "sharp": "^0.34.5",
    "ws": "^8.18.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.1",
    "@types/sharp": "^0.32.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "overrides": {
      "hono": ">=4.11.7",
      "qs": ">=6.14.1"
    }
  }
}
